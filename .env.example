# Copy these into .env.local (local dev) and into Vercel → Settings → Environment Variables.
# Never commit real values.

GOOGLE_MAPS_API_KEY=

# Stripe (Dashboard → Developers → API keys). Use sk_test_... while testing.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe (Dashboard → Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firebase Admin (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=csa-registration-1ed70
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@csa-registration-1ed70.iam.gserviceaccount.com
# Keep the quotes and the literal \n line breaks exactly as they appear in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"

# EmailJS order confirmation emails (see ORDERING_SETUP.md, "Confirmation emails")
EMAILJS_SERVICE_ID=service_v55fj6r
EMAILJS_ORDER_TEMPLATE_ID=template_xxx
EMAILJS_PUBLIC_KEY=YXPuuE9WWkJni1Uzb
# EmailJS → Account → API keys → Private Key
EMAILJS_PRIVATE_KEY=

# Optional: your live URL, used for Stripe's return links. Defaults to the current site URL.
# NEXT_PUBLIC_SITE_URL=https://www.hometownharvestllc.com
